<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- HTTPS (always use TLS in production) ---
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- Canonical host: apex (non-www) — https://lookuppostcode.com ---
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # --- Duplicate index URLs -> / (HTTP 301) ---
  RewriteCond %{THE_REQUEST} \s/+index\.html(\?[^\s]*)?\s [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+index\.php(\?[^\s]*)?\s [NC]
  RewriteRule ^index\.php$ / [R=301,L]

  # --- Serve real files and directories as-is ---
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # --- Missing static assets: return real 404 (not SPA shell with 200) ---
  RewriteCond %{REQUEST_URI} \.(?:css|js|mjs|map|png|gif|jpe?g|webp|svg|ico|woff2?|ttf|eot|json|txt|pdf|xml|webmanifest)$ [NC]
  RewriteRule ^ - [R=404,L]

  # --- SPA: all other paths -> index.html ---
  RewriteRule ^ index.html [L]
</IfModule>
