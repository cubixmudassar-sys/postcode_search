APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8443

# Production (api.lookuppostcode.com / lookuppostcode.com):
# APP_URL=https://api.lookuppostcode.com
# FRONTEND_URL=https://lookuppostcode.com
# SANCTUM_STATEFUL_DOMAINS=lookuppostcode.com,www.lookuppostcode.com
# LOTPAYMENT_GATEWAY_RETURN_URL=https://lookuppostcode.com/payment/lotpayment/callback
# LOTPAYMENT_RESULT_URL=https://lookuppostcode.com/payment/result
#
# CORS (Laravel only — never set Access-Control-* in Apache .htaccess):
# CORS_ALLOWED_ORIGINS=https://trustscoring.com,https://www.trustscoring.com,https://lookuppostcode.com,https://www.lookuppostcode.com
# CORS_SUPPORTS_CREDENTIALS=false
# CORS_MAX_AGE=86400
# When CORS_ALLOWED_ORIGINS is not "*", config/cors.php also appends trustscoring.com
# and lookuppostcode.com, and matches subdomain patterns. Paths include api/* and
# trustscoring-api/* (widget proxy). allowed_headers is "*" so X-Environment is allowed.
#
# API host deploy checklist (required for CORS / homepage widgets):
# 1. DocumentRoot = .../laravel_api/public  (not the project root)
# 2. PHP 8.3+ for the api.lookuppostcode.com subdomain (composer requires ^8.3)
# 3. Disable directory indexes; keep .env outside the web root / denied
# 4. Set the production values above (FRONTEND_URL with no trailing slash)
# 5. Grant the DB user access to DB_DATABASE (cPanel MySQL → Add User To Database)
# 6. Remove any mod_headers Access-Control-* block from laravel_api/.htaccess
# 7. php artisan config:clear   (or config:cache after env is correct)
# 8. Upload root .htaccess + updated config/cors.php, then retest without /public prefix
# 9. Verify: GET /up, GET /api/v1/pricing-packages, OPTIONS /api/v1/auth/login,
#    GET /api/v1/public/postcodes/suggest?q=SW1 with Origin: https://lookuppostcode.com
#    Expect Access-Control-Allow-Origin reflecting the request Origin (not a fixed Apache list)
#    OPTIONS must Allow-Headers include x-environment (and x-organisation-id)
#    Note: /public/index.php/api/v1/... already returns ACAO when Laravel boots;
#    Apache HTML 404 on bare /api/... means DocumentRoot/.htaccess still wrong.

SANCTUM_STATEFUL_DOMAINS=localhost:8443,127.0.0.1:8443

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=postcode_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LOOKUP_API_BASE_URL=https://lookup.qmaily.com/api
LOOKUP_API_TIMEOUT=15

CANADA_POST_ADDRESSCOMPLETE_KEY=
# Optional. Overrides outbound Referer sent to Canada Post (must be allowed on the key).
# Useful locally when http://localhost is blocked: https://api.lookuppostcode.com/search_address
CANADA_POST_REFERER=

# LotPayment plan checkout (sandbox | live)
LOTPAYMENT_CLIENT_ID=
LOTPAYMENT_MODE=sandbox
LOTPAYMENT_CURRENCY=GBP
LOTPAYMENT_USE_SERVER_API=true
LOTPAYMENT_FALLBACK_FORM_POST=true
LOTPAYMENT_AMOUNT_AS_INTEGER=true
LOTPAYMENT_API_URL=https://api.lotpayment.com/api/test/transactions/create
LOTPAYMENT_CHECKOUT_URL=https://lotpayment.com/test/checkout?basket_id={basket_id}
LOTPAYMENT_API_LIVE_URL=https://api.lotpayment.com/api/transactions/create
LOTPAYMENT_CHECKOUT_LIVE_URL=https://lotpayment.com/checkout?basket_id={basket_id}
LOTPAYMENT_GATEWAY_RETURN_URL="${FRONTEND_URL}/payment/lotpayment/callback"
LOTPAYMENT_RESULT_URL="${FRONTEND_URL}/payment/result"
